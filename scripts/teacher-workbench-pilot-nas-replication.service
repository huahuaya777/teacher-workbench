[Unit]
Description=Replicate authorized Teacher Workbench pilot data snapshot to NAS
Wants=network-online.target
After=network-online.target teacher-workbench-pilot-backup.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/libexec/teacher-workbench-pilot-nas-replication copy
TimeoutStartSec=25min
Nice=10
IOSchedulingClass=best-effort
