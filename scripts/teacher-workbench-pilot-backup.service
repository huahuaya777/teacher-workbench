[Unit]
Description=Teacher Workbench pilot paired local backup
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/teacher-workbench-pilot-backup
TimeoutStartSec=25min
Nice=10
IOSchedulingClass=best-effort
