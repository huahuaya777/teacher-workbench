FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
COPY wheelhouse/ /wheelhouse/
RUN pip install --no-cache-dir --no-index --find-links=/wheelhouse -r requirements.txt && rm -rf /wheelhouse

# Keep the test image limited to the application files; wheelhouse is not copied
# into /app and local .env/data are excluded by .dockerignore.
COPY manage.py .
COPY config/ ./config/
COPY workbench/ ./workbench/
COPY templates/ ./templates/
COPY scripts/check_test_env.py ./scripts/check_test_env.py
RUN mkdir -p /app/data/private

EXPOSE 8000
CMD ["python", "manage.py", "check"]
