# 仅用于隔离测试环境。复制为 .env 后填入随机密钥；运行 scripts/check_test_env.py 核对。.env 不得提交 Git。
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-long-random-test-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=teacher_workbench
DB_USER=teacher_workbench
DB_PASSWORD=replace-with-random-test-password

# 默认关闭。未选定厂商、费用与授权前保持 0，不填入真实 Key。
AI_ENABLED=0
# 阶段 1 千问测试：仅允许北京地域 qwen-flash，先在厂商控制台为所用 Key 设置预算。
AI_PROVIDER=qwen
# 北京通用地址适用于本机安全输入测试；若用业务空间专属地址，替换实际 WorkspaceId。
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
AI_MODEL=qwen-flash
AI_API_KEY=
# Compose 测试栈强制 AI_ENABLED=0 且 AI_API_KEY 为空，不会进行付费调用。
AI_MAX_OUTPUT_TOKENS=1500
# 只供本机 DEBUG + SQLite 阶段 1 测试；任务需助手逐个显式执行。
AI_LOCAL_QUEUE=0
