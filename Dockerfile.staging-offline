FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
COPY wheelhouse/ /wheelhouse/
RUN pip install --no-cache-dir --no-index --find-links=/wheelhouse -r requirements.txt && rm -rf /wheelhouse
COPY manage.py .
COPY config/ ./config/
COPY workbench/ ./workbench/
COPY templates/ ./templates/
COPY scripts/check_test_env.py ./scripts/check_test_env.py
COPY scripts/check_staging_env.py ./scripts/check_staging_env.py
RUN mkdir -p /app/data/private
EXPOSE 8000
